# QA/One API — environment
# LLM provider: mock | anthropic | openai | groq | gemini | openrouter
LLM_PROVIDER=mock
# Postgres (docker compose) or local sqlite fallback
DATABASE_URL=postgresql+asyncpg://qahub:qahub@localhost:5432/qahub
# URL of the Playwright runner worker
RUNNER_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
