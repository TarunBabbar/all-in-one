# QA/One API — environment (committed template; copy to .env and fill secrets).
# LLM provider: mock | cmdc | commandcode
LLM_PROVIDER=mock

# cmdc CLI binary (authenticated session) — used by the cmdc provider.
CMDC_BIN=cmdc

# Command Code Provider API (REST) + model id used by both cmdc paths.
CMD_API_KEY=
CMD_MODEL=deepseek/deepseek-v4-flash-fast
CMD_API_BASE=https://api.commandcode.ai/provider/v1

# Neon Postgres (serverless) or local. sqlite fallback works for dev.
DATABASE_URL=postgresql+asyncpg://user:pass@host/db?sslmode=require

# URL of the Playwright runner worker
RUNNER_URL=http://localhost:8787
# Base URL of the app under test. Only used when the requirement text does not
# itself contain a URL — the requirement's own URL (if any) takes precedence.
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Run limits ---------------------------------------------------------
# One heal attempt is a full Playwright run, so each attempt gets its own
# timeout rather than sharing a single timer across the whole loop.
RUNNER_CALL_TIMEOUT_S=420
INSPECT_TIMEOUT_S=90
# How many times the executor may heal + rerun a failing suite. Tests still
# failing after this are reported as needing a manual run, never as passing.
MAX_HEAL_ATTEMPTS=5
# Hard ceiling for one run stage so a loop cannot spin forever (seconds).
STAGE_BUDGET_S=1800
# Safety cap for test-case generation (coverage-driven, so this only bounds
# a pathologically verbose requirement). Raise freely.
MAX_TEST_CASES=120

# --- DeepEval -----------------------------------------------------------
# Metrics are deterministic (no LLM judge), so the eval gates run offline.
DEEPEVAL_TELEMETRY_OPT_OUT=1

# --- Jira (REST; basic auth = email + API token) ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_AUTH_MODE=basic
JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20
JIRA_TIMEOUT_SECONDS=30

# --- GitHub (REST; token + repo to push/pull code) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=master
